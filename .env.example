# Crie uma cópia deste arquivo com o nome .env antes de subir o projeto.
# docker compose lê as variáveis deste arquivo automaticamente.
# Nunca comite o arquivo .env real.

# API / App
JWT_SECRET=rex-super-secret-jwt-key-change-in-production
APP_ENV=production

# Origens autorizadas a enviar o cookie de refresh (separadas por vírgula).
# Não pode ser "*": requisições com credenciais exigem origem explícita.
FRONTEND_ORIGIN=http://localhost:5173

# Cookie do refresh token.
# SameSite=Lax cobre frontend e API no mesmo site (inclusive portas diferentes).
# Use None + REFRESH_COOKIE_SECURE=true quando forem domínios distintos (exige HTTPS).
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_SECURE=false

# Banco de dados da aplicação
DB_HOST=db
DB_NAME=rex
LOG_DB_NAME=rex_logs
DB_USER=rex
DB_PASSWORD=rex

# Banco de dados (MySQL init)
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=rex
MYSQL_USER=rex
MYSQL_PASSWORD=rex

# Auditoria (chave de criptografia AES-256-CBC)
AUDIT_LOG_ENCRYPTION_KEY=rex-audit-default-key-change-me

# Frontend
VITE_API_URL=http://localhost:8080
