{
  "name": "rex/rex",
  "description": "Plataforma de incentivo 'Vendeu, Ganhou'",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "firebase/php-jwt": "^6.10"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10",
    "friendsofphp/php-cs-fixer": "^3.64"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "policy": {
      "advisories": {
        "block": false
      }
    }
  }
}
